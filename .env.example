SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=any-long-random-string
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# Gmail API (OAuth2, scope: https://www.googleapis.com/auth/gmail.send)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=your.gmail.address@gmail.com
# Where guest messages from the contact form are delivered (defaults to GMAIL_SENDER)
CONTACT_EMAIL_TO=

# WhatsApp number guests message, digits only with country code, e.g. 263772123456
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: guest helper chat. Leave GEMINI_API_KEY empty to hide it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
